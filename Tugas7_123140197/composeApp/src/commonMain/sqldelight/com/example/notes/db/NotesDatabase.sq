CREATE TABLE NoteEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    isDone INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL
);

getAllNotes:
SELECT * FROM NoteEntity ORDER BY updatedAt DESC;

getNoteById:
SELECT * FROM NoteEntity WHERE id = :id;

insertNote:
INSERT OR REPLACE INTO NoteEntity(id, title, content, isDone, updatedAt)
VALUES (?, ?, ?, ?, ?);

deleteNote:
DELETE FROM NoteEntity WHERE id = :id;

updateDoneStatus:
UPDATE NoteEntity SET isDone = :isDone, updatedAt = :updatedAt WHERE id = :id;

searchNotes:
SELECT * FROM NoteEntity WHERE title LIKE ('%' || :query || '%') OR content LIKE ('%' || :query || '%') ORDER BY updatedAt DESC;
